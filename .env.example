# OptiStock AI - Environment Configuration

# Flask Application Settings
SECRET_KEY=optistock-secure-key-change-in-production
FLASK_ENV=production
PORT=5000

# SQLite Database Path (Absolute or relative to workspace root)
OPTISTOCK_DB_PATH=data/optistock_automation.db

# Automation Background Scheduler Configuration
# Set to 'false' if running the standalone worker process (python -m engine.automation_scheduler)
SCHEDULER_AUTOSTART=true

# Scheduler polling cycle interval in seconds (default: 10s)
SCHEDULER_POLL_INTERVAL=10

# Security PINs for Dashboard Role Verification (Defaults)
ADMIN_PIN=1111
WAREHOUSE_PIN=2222
RETAIL_PIN=3333
DELIVERY_PIN=4444
